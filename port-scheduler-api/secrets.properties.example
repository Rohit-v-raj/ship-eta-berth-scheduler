# Copy this file to secrets.properties (same folder) and fill in real values.
# secrets.properties is gitignored and is loaded by application.properties via
# spring.config.import, so nothing secret ever lives in a tracked file.

# Google AI Studio API key for the harbor-master agent
spring.ai.google.genai.api-key=your-google-ai-studio-key

# Password for the MySQL user in spring.datasource.username
spring.datasource.password=your-db-password
