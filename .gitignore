# Python
__pycache__/
*.pyc
*.pyo

# Virtual environment (lives alongside the project)
../port_ml_env/
port_ml_env/

# Data — large AIS parquet files and generated datasets
data/parquets/
data/processed/
data/raw/

# Study workbooks — contain raw AIS rows + vessel identities extracted from the
