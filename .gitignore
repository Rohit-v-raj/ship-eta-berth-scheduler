reports/*.xlsx

# Trained model artefacts
models/*.pkl
models/*.h5
models/*.keras
models/*.pt

# Research paper PDFs — copyrighted; plain-language summaries (.md) are ours
references/*.pdf

# Spring Boot / Gradle build output
port-scheduler-api/build/
port-scheduler-api/.gradle/
port-scheduler-api/bin/

# Local secrets (API key, DB password) — copy secrets.properties.example
port-scheduler-api/secrets.properties

# Jupyter
.ipynb_checkpoints/

# Claude Code local settings
.claude/

# OS / editor
.DS_Store
.vscode/
.idea/

# Scratch — throwaway experiments (keep the documented ablation)
scratch/*
